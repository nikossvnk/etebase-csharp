<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The Cargo profile (target/debug or target/release) the native library is taken from: build it with Cargo first -->
    <CargoProfile Condition="'$(CargoProfile)' == ''">debug</CargoProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C# wrapper generated by `cargo build` -->
    <ProjectReference Include="../target/dotnet-out/etebase_csharp.csproj" />
    <None Include="../target/$(CargoProfile)/*etebase_csharp_native.so;../target/$(CargoProfile)/*etebase_csharp_native.dylib;../target/$(CargoProfile)/*etebase_csharp_native.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
